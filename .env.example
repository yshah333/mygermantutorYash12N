# Required: your Gemini API key from Google AI Studio (never commit the real one)
GEMINI_API_KEY=

# Recommended: a passcode so only you can start sessions (and spend your credit)
APP_PASSCODE=

# Optional: her voice (pick one you liked in AI Studio) and the Live model
TUTOR_VOICE=Kore
GEMINI_LIVE_MODEL=gemini-3.8-live
